{
  "expo": {
    "name": "Gobbl",
    "slug": "FoodWrapped",
    "version": "5.0.0",
    "scheme": "com.ncoderpro.foodwrapped",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ncoderpro.foodwrapped",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Gobbl uses your camera to photograph your meals.",
        "NSPhotoLibraryUsageDescription": "Gobbl accesses your photo library so you can log meals from existing photos.",
        "NSLocationWhenInUseUsageDescription": "Gobbl uses your location to tag where you got a meal so you can find great spots again later."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ncoderpro.foodwrapped",
      "googleServicesFile": "./google-services.json" 
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1fdf8914-bc1a-4e5c-b5a8-affda263178e"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF6B3D"
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Gobbl uses your camera to photograph your meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gobbl accesses your photo library so you can log meals from existing photos."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "react-native-maps",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1284911551875378~4973034735",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics"
    ]
  }
}
